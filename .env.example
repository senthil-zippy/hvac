# Local development environment variables for ZoneIQ backend
# Copy this file to .env and adjust values as needed. Never commit .env itself.

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=zoneiq
POSTGRES_USER=zoneiq
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql://zoneiq:change-me-locally@localhost:5432/zoneiq

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
LOG_LEVEL=INFO

# --- Pagination defaults (ZIQ-101) ---
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200
